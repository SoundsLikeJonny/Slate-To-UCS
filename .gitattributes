# Text files are LF in the repository regardless of a contributor's core.autocrlf.
* text=auto eol=lf

# PowerShell keeps CRLF: Windows PowerShell 5.1 mis-parses LF-only scripts.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary fixtures and artefacts.
# The UCS CSV is a byte-exact copy of the upstream artefact and its SHA-256 is pinned
# in `crates/slate-ucs/src/resources.rs`, so it must not be line-ending normalised.
*.csv binary
*.wav binary
*.flac binary
*.mp3 binary
*.onnx binary
*.gguf binary
*.safetensors binary
*.msi binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
*.png binary
*.ico binary
